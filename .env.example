# Copy to .env (git-ignored) and adjust. All optional.

# Where your personal database lives. Default: data/applytrail.db
# APPLYTRAIL_DB=~/Documents/private/applytrail.db

# Days of silence before an active application counts as "no reply".
# APPLYTRAIL_GHOST_DAYS=21

# Days without movement in a stage before an open application counts as "pending".
# APPLYTRAIL_PENDING_DAYS=7
